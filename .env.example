# ==================================
# Environment Configuration Template
# ==================================
# Copy this file to .env and fill with your actual values
# NEVER commit the .env file to version control

# ==================================
# INE API Configuration
# ==================================
# Instituto Nacional de Estadística API settings
INE_API_BASE_URL=https://servicios.ine.es/wstempus/js
INE_API_TIMEOUT=30
INE_API_MAX_RETRIES=3

# ==================================
# DataBank API Configuration
# ==================================
# World Bank DataBank API settings
DATABANK_API_KEY=your_api_key_here
DATABANK_BASE_URL=https://api.worldbank.org/v2
DATABANK_TIMEOUT=30

# ==================================
# Banco de España API
# ==================================
BDE_API_BASE_URL=https://app.bde.es/api
BDE_API_TIMEOUT=30

# ==================================
# Database Configuration
# ==================================
# SQLite database path (relative or absolute)
DATABASE_PATH=./datawarehouse.db
DATABASE_V2_PATH=./database 2/datawarehouse.db
DATABASE_LEGACY_PATH=./data base/datawarehouse.db

# Database connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ==================================
# Dashboard Configuration (Streamlit)
# ==================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Dashboard theme
STREAMLIT_THEME_PRIMARY_COLOR=#1f77b4
STREAMLIT_THEME_BACKGROUND_COLOR=#ffffff
STREAMLIT_THEME_SECONDARY_BACKGROUND_COLOR=#f0f2f6

# ==================================
# Logging Configuration
# ==================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_PATH=./logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==================================
# ETL Configuration
# ==================================
# Data download paths
ETL_RAW_DATA_PATH=./data/raw
ETL_PROCESSED_DATA_PATH=./data/processed
ETL_BACKUP_PATH=./backups

# ETL processing settings
ETL_BATCH_SIZE=1000
ETL_WORKERS=4
ETL_TIMEOUT=3600

# Date ranges for data processing
ETL_START_YEAR=2014
ETL_END_YEAR=2020

# ==================================
# Cache Configuration
# ==================================
CACHE_ENABLED=true
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ==================================
# Security
# ==================================
# Secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# CORS settings
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ==================================
# Development Settings
# ==================================
DEBUG=false
ENVIRONMENT=development

# ==================================
# Azure SQL (if migrating from SQLite)
# ==================================
# AZURE_SQL_SERVER=your-server.database.windows.net
# AZURE_SQL_DATABASE=your-database
# AZURE_SQL_USERNAME=your-username
# AZURE_SQL_PASSWORD=your-password
# AZURE_SQL_DRIVER={ODBC Driver 17 for SQL Server}

# ==================================
# Monitoring & Analytics (optional)
# ==================================
# SENTRY_DSN=your-sentry-dsn
# GOOGLE_ANALYTICS_ID=your-ga-id

# ==================================
# Backup & Maintenance
# ==================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# ==================================
# Notes
# ==================================
# - All paths are relative to the project root unless specified as absolute
# - Timeouts are in seconds
# - Sizes are in bytes (10485760 = 10MB)
# - For production, set DEBUG=false and ENVIRONMENT=production
# - Remember to generate a strong SECRET_KEY for production
