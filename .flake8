[flake8]
# Flake8 configuration file
# Documentation: https://flake8.pycqa.org/en/latest/user/configuration.html

# Maximum line length
max-line-length = 100

# Maximum complexity (McCabe)
max-complexity = 10

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    ENV,
    .tox,
    .eggs,
    *.egg,
    build,
    dist,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    .ipynb_checkpoints

# Ignore specific errors
# E203: whitespace before ':' (conflicts with Black)
# W503: line break before binary operator (conflicts with Black)
# E501: line too long (handled by Black)
extend-ignore = E203, W503, E501

# Per-file ignores
per-file-ignores =
    __init__.py: F401
    # Allow unused imports in __init__.py files

# Enable specific checks
select =
    E,   # pycodestyle errors
    W,   # pycodestyle warnings
    F,   # pyflakes
    C,   # mccabe complexity
    B,   # bugbear (if installed)
    # Add more as needed

# Show source code for errors
show-source = True

# Show statistics
statistics = True

# Count errors
count = True

# Format
format = default
